# Copy this file to `.env` (same folder) and replace the placeholder values.
# Never commit the real .env file: it is listed in .gitignore.

NODE_ENV=development
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=expense_app
DB_PASSWORD=change_me
DB_NAME=expense_tracker

# Secret used to sign login tokens. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# How many hours a login lasts before the user must sign in again.
SESSION_HOURS=24

# Frontend origin(s) allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Optional: password for the demo account created by `npm run db:seed`.
SEED_DEMO_PASSWORD=
