# Settings for the automated tests (`npm test`).
# Copy to `.env.test`. Use a SEPARATE database: the tests delete their own
# test data from it between runs.

NODE_ENV=test
DB_HOST=localhost
DB_PORT=3306
DB_USER=expense_app
DB_PASSWORD=change_me
DB_NAME=expense_tracker_test

JWT_SECRET=test_secret_that_is_at_least_32_characters_long
SESSION_HOURS=24
CLIENT_ORIGIN=http://localhost:5173
