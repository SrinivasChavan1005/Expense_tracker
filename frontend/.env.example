# Optional frontend settings. Copy to `.env` only if you need to change them.
# Never put secrets here: every VITE_ variable is bundled into public JavaScript.

# Where the Vite dev server forwards /api requests (the Express backend).
VITE_PROXY_TARGET=http://localhost:5000

# Base URL the browser uses for API calls. Leave as /api to use the proxy above.
# Set a full URL (e.g. https://api.example.com/api) only if the API is hosted elsewhere.
VITE_API_URL=/api
